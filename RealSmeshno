<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Конверт</title>
<style>
:root{--bg:#000;--hint:#e9d6d9;--paper:#f6efe3;--env:#c9a77c;--env2:#b8935f;--env3:#d6b78d;--seal:#8b0a1e;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root{--bg:#000}}
:root:not([data-theme="light"]){color-scheme:dark}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--hint);font-family:Georgia,"Times New Roman",serif;overflow:hidden;position:relative}
.roses{position:fixed;inset:0;pointer-events:none}
.roses svg{position:absolute;filter:drop-shadow(0 0 14px rgba(190,20,50,.35));animation:sway 7s ease-in-out infinite alternate}
.r1{width:150px;left:-30px;top:-20px;transform:rotate(-25deg)}
.r2{width:90px;right:8%;top:6%;transform:rotate(30deg);animation-delay:-2s!important}
.r3{width:190px;right:-50px;top:38%;transform:rotate(-70deg);animation-delay:-4s!important}
.r4{width:120px;left:6%;bottom:-25px;transform:rotate(15deg);animation-delay:-1s!important}
.r5{width:170px;right:-20px;bottom:-30px;transform:rotate(40deg);animation-delay:-3s!important}
.r6{width:70px;left:3%;top:42%;transform:rotate(-10deg);animation-delay:-5s!important}
@keyframes sway{to{margin-top:8px;margin-left:-4px}}
main{position:relative;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:56px}
.hint{font-size:22px;letter-spacing:.04em;transition:opacity .5s}
.opened .hint{opacity:0}
.scene{width:min(320px,86vw);height:calc(min(320px,86vw)*.66);position:relative;transition:transform 1.1s ease .2s}
.env{position:absolute;inset:0;cursor:pointer;background:none;border:0;padding:0;width:100%;height:100%;-webkit-tap-highlight-color:transparent}
.env:focus-visible{outline:2px solid #e23b57;outline-offset:8px}
.back{position:absolute;inset:0;background:linear-gradient(var(--env2) 0 50%,var(--env) 50% 100%);border-radius:4px;box-shadow:0 20px 50px rgba(0,0,0,.8)}
.letter{will-change:transform;backface-visibility:hidden;position:absolute;left:5%;right:5%;top:6%;bottom:2%;background:var(--paper);border-radius:3px;padding:3%;z-index:2;transition:transform 1s cubic-bezier(.4,0,.2,1);box-shadow:0 2px 8px rgba(0,0,0,.35)}
.letter img{width:100%;height:100%;object-fit:contain;display:block;background:#fff}
.pocket{position:absolute;inset:0;z-index:3;pointer-events:none}
.pocket i{position:absolute;inset:0;display:block}
.pl{background:var(--env);clip-path:polygon(0 0,53% 52%,0 100%)}
.pr{background:var(--env);clip-path:polygon(100% 0,47% 52%,100% 100%)}
.pb{background:var(--env3);clip-path:polygon(0 100%,50% 45%,100% 100%)}
.flap{position:absolute;left:0;right:0;top:0;height:55%;transform-origin:top;z-index:4;will-change:transform;transition:transform .7s ease,z-index 0s .35s;pointer-events:none}
.flap i{position:absolute;inset:0;background:var(--env3);clip-path:polygon(0 0,100% 0,50% 100%)}
.seal{position:absolute;left:50%;top:44%;width:30px;height:30px;margin:-15px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#d02a45,var(--seal));box-shadow:0 2px 6px rgba(0,0,0,.6);z-index:5;transition:opacity .3s}
.opened .seal{opacity:0}
.opened .flap{transform:scaleY(-1);z-index:1}
.opened .letter{transform:translateY(-62%)}
.opened.out .letter{z-index:6;transform:translateY(-98%) scale(1.15)}
.opened.out .scene{transform:translateY(110px)}
@media (prefers-reduced-motion:reduce){*{transition-duration:.01s!important;animation:none!important}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute"><defs>
<symbol id="rose" viewBox="0 0 100 100">
<path d="M50 60C20 70 10 95 15 98 40 95 50 80 50 60Z" fill="#1d5c2e"/>
<path d="M50 60C80 70 90 95 85 98 60 95 50 80 50 60Z" fill="#17492a"/>
<circle cx="50" cy="45" r="32" fill="#7d0a1c"/>
<path d="M22 40C22 18 78 18 78 40 78 62 28 68 24 48 22 32 66 26 70 44 72 58 34 58 36 44 38 34 58 34 58 44" fill="none" stroke="#e23b57" stroke-width="4" stroke-linecap="round"/>
<path d="M28 58C40 72 64 72 74 58" fill="none" stroke="#b01a35" stroke-width="5" stroke-linecap="round"/>
</symbol></defs></svg>
<div class="roses" aria-hidden="true">
<svg class="r1"><use href="#rose"/></svg><svg class="r2"><use href="#rose"/></svg><svg class="r3"><use href="#rose"/></svg>
<svg class="r4"><use href="#rose"/></svg><svg class="r5"><use href="#rose"/></svg><svg class="r6"><use href="#rose"/></svg>
</div>
<main id="m">
<div class="hint">Нажми чтобы открыть</div>
<div class="scene">
<button class="env" id="e" aria-label="Открыть конверт">
<div class="back"></div>
<div class="letter"><img alt="Записка" src="data:image/jpeg;base64,"></div>
<div class="pocket"><i class="pl"></i><i class="pr"></i><i class="pb"></i></div>
<div class="flap"><i></i></div>
<div class="seal"></div>
</button>
</div>
</main>
<script>
var m=document.getElementById('m'),e=document.getElementById('e'),done=false;
e.addEventListener('click',function(){
 if(done)return;done=true;
 m.classList.add('opened');
 setTimeout(function(){m.classList.add('out')},1800);
});
</script>
</body>
</html>
